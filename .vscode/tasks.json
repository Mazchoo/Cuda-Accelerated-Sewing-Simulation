{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Run Ruff",
        "type": "process",
        "command": "py",
        "args": [
            "-m",
            "ruff",
            "format",
            "."
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      },
      {
        "label": "Pylint Current File",
        "type": "process",
        "command": "py",
        "args": [
            "-m",
            "pylint",
            "${file}"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      }
    ]
  }
  